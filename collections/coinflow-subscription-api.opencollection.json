                "name": "x-coinflow-auth-session-key",
                "value": ""
              },
              {
                "name": "x-device-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "merchantId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Purchase a subscription with an existing credit card"
        },
