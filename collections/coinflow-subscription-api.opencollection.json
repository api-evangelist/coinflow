          "info": {
            "name": "Purchase Subscription with New Card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.coinflow.cash/api/subscription/:merchantId/subscribers/card",
            "headers": [
              {
                "name": "x-coinflow-auth-session-key",
                "value": ""
              },
              {
                "name": "x-device-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "merchantId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Purchase a subscription with a new credit card"
        }
      ]
    }
  ],
  "bundled": true
}