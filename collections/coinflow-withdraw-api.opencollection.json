            "params": [
              {
                "name": "redirectLink",
                "value": "",
                "type": "query",
                "description": "(optional): The URL to which the user will be redirected after\nsuccessfully completing verification via verificationLink. This applies\nwhen the API responds with a 451 status code, instructing the caller\nto direct the user to verificationLink first."
              }
