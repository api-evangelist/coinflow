          "info": {
            "name": "Add Bank Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.coinflow.cash/api/customer/v2/bankAccount",
            "headers": [
              {
                "name": "x-coinflow-auth-wallet",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a bank account for a given customer"
        },
        {
          "info": {
            "name": "Bank Account Status Check",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.coinflow.cash/api/customer/plaid-check",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Checks whether a customer's linked bank account is still active and\nvalid. Returns a normalized status (`active`, `removed`, `login_required`,\nor `error`) that merchants can use to gate transaction attempts before\nsubmission."
        },
